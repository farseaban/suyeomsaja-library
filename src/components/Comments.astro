---
import { GISCUS, giscusOn, giscusThread } from '../config/giscus'

const { slug } = Astro.props as { slug: string }
---
{giscusOn && (
  <section class="comments wrap-narrow">
    <script is:inline src="https://giscus.app/client.js"
      data-repo={GISCUS.repo} data-repo-id={GISCUS.repoId} data-category="Announcements" data-category-id={GISCUS.categoryId}
      {...giscusThread(slug)} data-reactions-enabled="1" data-emit-metadata="0"
      data-input-position="top" data-theme="light" data-lang="ko" crossorigin="anonymous" async></script>
  </section>
)}
