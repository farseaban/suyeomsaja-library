---
import { orbFields } from '../lib/orb'
// avoid: 낱말을 띄우지 않을 자리 "x0,y0,x1,y1"(캔버스 비율). 위에 다른 그림이 겹칠 때 쓴다.
const { avoid } = Astro.props as { avoid?: string }
---
<div class="s-orb">
  <canvas class="s-orb-canvas" aria-hidden="true" data-fields={JSON.stringify(orbFields())} data-avoid={avoid}></canvas>
</div>
<script>
  import '../scripts/orb'
</script>
