---
import { SITE } from '../config/site'
import { activeCategories, loadPosts } from '../lib/posts'
import { url } from '../lib/url'

// 두 단: 이름 + 기능 메뉴 / 분야 줄. 지금 있는 곳의 링크에 aria-current를 단다.
const cats = activeCategories(loadPosts())
const here = Astro.url.pathname
const cur = (href: string) => (here === href ? 'page' : undefined)
const all = url('all'), about = url('about'), search = url('search')
---
<header class="masthead">
  <div class="wrap bar">
    <a class="name" href={url('/')}>{SITE.name}</a>
    <nav class="util" aria-label="사이트 메뉴">
      <a href={all} aria-current={cur(all)}>모든 글</a>
      <a href={about} aria-current={cur(about)}>소개</a>
      <a class="search" href={search} aria-label="검색" aria-current={cur(search)}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
    </nav>
  </div>
  <nav class="wrap shelfbar" aria-label="분야">
    <span class="links">
      <span class="cats">
        {cats.map((c) => {
          const href = url(`category/${c.slug}`)
          return <a href={href} aria-current={cur(href)}>{c.name}</a>
        })}
      </span>
    </span>
  </nav>
</header>
<script>
  // 휴대폰에서 옆으로 밀리는 분야 줄: 넘긴 쪽 끝만 흐리게
  for (const el of document.querySelectorAll<HTMLElement>('.masthead .links')) {
    const update = () => {
      el.classList.toggle('scrolled', el.scrollLeft > 1)
      el.classList.toggle('at-end', el.scrollLeft + el.clientWidth >= el.scrollWidth - 1)
    }
    el.addEventListener('scroll', update, { passive: true })
    addEventListener('resize', update)
    update()
  }
</script>
