---
import '../styles/tokens.css'
import '../styles/site.css'
import '../styles/post.css'
import Masthead from '../components/Masthead.astro'
import Footer from '../components/Footer.astro'
import NightSky from '../components/NightSky.astro'
import { SITE, type PaletteKey } from '../config/site'
import { buildCsp } from '../config/csp'
import { giscusOn } from '../config/giscus'
import { blocksIndexing } from '../config/indexing'
import { url } from '../lib/url'

// bodyClass: 페이지 종류(p-front · p-list · p-post · p-about · p-search · p-404)
// dawn: 분야·글 페이지의 분야 색 — 지평선의 새벽빛과 강조색이 그 색으로 스민다
// skyDrag: 하늘을 끌 수 있는 페이지(1면만)
// heroPlain: 1면에 글이 한 편도 없을 때 — 머리기사가 지던 글자 한계선 여백을 히어로가 되찾는다
interface Props {
  title?: string; description?: string; ogType?: 'website' | 'article'; ogImage?: { path: string; version: string; alt: string }
  bodyClass?: string; dawn?: PaletteKey; skyDrag?: boolean; heroPlain?: boolean
}
const { title, description = SITE.description, ogType = 'website', bodyClass, dawn, skyDrag = false, heroPlain = false } = Astro.props
// body에 둔다 — body에 붙는 각주 말풍선과 읽기 띠도 같은 색을 물려받는다
const dawnStyle = dawn ? `--s-dawn:var(--${dawn});--s-accent:var(--${dawn}-d);--s-accent-ink:var(--${dawn}-ink);--s-accent-tint:var(--${dawn})` : undefined
const og = Astro.props.ogImage ?? { path: 'og-card.png', version: '', alt: `밤하늘 아래 로봇 곁에 선 ${SITE.author}와 ${SITE.name}` }
const fullTitle = title ? `${title} — ${SITE.name}` : SITE.name
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  {/* 공개 빌드에만 건다. 개발 서버와 편집 모드는 인라인 스크립트로 돈다 */}
  {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={buildCsp(giscusOn)} />}
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="#212029">
  <meta name="color-scheme" content="only light">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  {blocksIndexing(import.meta.env.PUBLIC_ALLOW_INDEXING) && <meta name="robots" content="noindex, nofollow">}
  <meta property="og:title" content={title ?? SITE.name}>
  <meta property="og:description" content={description}>
  <meta property="og:type" content={ogType}>
  <meta property="og:site_name" content={SITE.name}>
  <meta property="og:image" content={new URL(url(og.path), Astro.site).href + (og.version ? `?v=${og.version}` : '')}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content={og.alt}>
  <meta name="twitter:card" content="summary_large_image">
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href={url('rss.xml')}>
  <link rel="icon" type="image/svg+xml" href={url('favicon.svg')}>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;700&display=swap">
  <slot name="head" />
</head>
<body class={bodyClass} style={dawnStyle}>
  <a class="s-skip" href="#main">본문으로</a>
  <div class="s-top">
    <NightSky drag={skyDrag} />
    <Masthead />
    <div class={heroPlain ? 's-hero s-hero-plain' : 's-hero'}><slot name="hero" /></div>
  </div>
  <main id="main"><slot /></main>
  <Footer />
</body>
</html>
