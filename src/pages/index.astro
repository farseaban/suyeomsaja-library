---
import Base from '../layouts/Base.astro'
import { loadPosts, minutesLabel, pickFeatured } from '../lib/posts'
import { url } from '../lib/url'
import Chip from '../components/Chip.astro'
import Title from '../components/Title.astro'
import SecHead from '../components/SecHead.astro'
import Shelf from '../components/Shelf.astro'
import LeadScene from '../components/LeadScene.astro'

const posts = loadPosts()
const lead = pickFeatured(posts)
const rest = posts.filter((p) => p !== lead).slice(0, 6)
const when = (d: string) => d.replaceAll('-', '.')
const leadMin = lead ? minutesLabel(lead.minutes) : null
---
<Base bodyClass="p-front" skyDrag heroPlain={!lead}>
  <div class="wrap" slot="hero">
    {!lead && <p class="empty s-serif">첫 글을 준비하고 있습니다.</p>}
    {lead && (
      <section class="lead">
        <div class="s-lead-text">
          <p class="s-eyebrow"><Chip name={lead.category} slug={lead.categorySlug} color={lead.color} />{' '}<span class="s-label">새 글</span></p>
          <h1 class="s-serif" style={`view-transition-name:t-${lead.slug}`}><a href={url(`posts/${lead.slug}`)}><Title title={lead.title} /></a></h1>
          <p class="sum">{lead.description}</p>
          <p class="when">{when(lead.date)}{leadMin && ` · ${leadMin}`}</p>
        </div>
        <LeadScene />
      </section>
    )}
  </div>
  <div class="wrap front">
    {rest.length > 0 && (
      <section class="s-sec">
        <SecHead title="최근 글" more={{ href: url('all'), text: '모든 글 보기 →' }} />
        <div class="grid">
          {rest.map((p) => {
            const min = minutesLabel(p.minutes)
            return (
              <article class="cell">
                <p class={`s-band s-cat-${p.color}`}><a class="s-band-cat" href={url(`category/${p.categorySlug}`)}>{p.category}</a>{min && <Fragment>{' '}<span class="s-band-min">{min}</span></Fragment>}</p>
                <h3 class="s-serif" style={`view-transition-name:t-${p.slug}`}><a href={url(`posts/${p.slug}`)}><Title title={p.title} /></a></h3>
                <p class="sum">{p.description}</p>
              </article>
            )
          })}
        </div>
      </section>
    )}
    {posts.length > 0 && (
      <section class="s-sec">
        <SecHead title="분야별" />
        <Shelf />
      </section>
    )}
  </div>
</Base>
