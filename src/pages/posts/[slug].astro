---
import Base from '../../layouts/Base.astro'
import PostRow from '../../components/PostRow.astro'
import Comments from '../../components/Comments.astro'
import AuthorBox from '../../components/AuthorBox.astro'
import PostReading from '../../components/PostReading.astro'
import PostEnhance from '../../components/PostEnhance.astro'
import EditMode from '../../components/EditMode.astro'
import Chip from '../../components/Chip.astro'
import Title from '../../components/Title.astro'
import SecHead from '../../components/SecHead.astro'
import { presentPost } from '../../lib/present'
import { loadPosts, neighbors, seriesLabel, seriesPosition, type Post } from '../../lib/posts'
import { url } from '../../lib/url'
import { cardVersion } from '../../lib/card'
import { relatedPosts } from '../../lib/related'
import { SITE } from '../../config/site'

export function getStaticPaths() {
  return loadPosts().map((post) => ({ params: { slug: post.slug }, props: { post } }))
}

const all = loadPosts()
// 개발 서버는 경로 목록(props)을 기억해 두므로 글은 방금 읽은 목록에서 꺼낸다 — 편집 저장 뒤 새로고침이 바로 반영된다
const post = all.find((p) => p.slug === (Astro.props as { post: Post }).post.slug)!
const { prev, next } = neighbors(all, post.slug)
const pos = seriesPosition(all, post.slug)
// 표현 변환(공개 글 페이지에서만): 글머리를 본문에서 떼어 밤 구역에 올리고, 도해·문장형 표에 휴대폰용 표시를 단다. 글 원문은 그대로다
const { body, toc, titleHtml } = presentPost(post.articleHtml)
// 함께 읽을 글(사용자 11/10): meta.json의 related를 먼저, 나머지는 본문이 비슷한 글로 — 분야를 넘나든다
const related = relatedPosts(all, post, 3)
---
<Base title={post.title} description={post.description} ogType="article" bodyClass="p-post" dawn={post.color} ogImage={post.cardPath ? { path: `posts/${post.slug}/card.png`, version: cardVersion(post), alt: `${post.category} · ${post.title} — ${SITE.name}` } : undefined}>
  <style is:inline set:html={post.scopedCss} slot="head" />
  {/* 글머리 — 652px 글 칸에 맞춘다(.wrap으로 감싸지 않는다). 제목은 본문 칸 밖이라 검색 색인에 따로 넣는다 */}
  <header class="s-post-head" slot="hero">
    <p class="s-post-k"><Chip name={post.category} slug={post.categorySlug} color={post.color} data-pagefind-ignore="" />{post.kicker && <span class="s-post-kicker">{post.kicker}</span>}</p>
    <h1 class="s-serif" style={`view-transition-name:t-${post.slug}`} data-pagefind-body>{titleHtml ? <Fragment set:html={titleHtml} /> : <Title title={post.title} />}</h1>
    {post.metaLine && <p class="s-post-meta">{post.metaLine}</p>}
  </header>
  <div class="s-post" style={`--s-accent:var(--${post.color}-d)`}>
    <div class="post-body" data-pagefind-body data-pagefind-meta={`category:${post.category}`}>
      <article set:html={body} />
    </div>
    {toc.length >= 2 && <PostReading toc={toc} />}
  </div>
  <PostEnhance color={post.color} />
  {process.env.SUYEOMSAJA_EDIT_TOKEN && <EditMode slug={post.slug} editing={false} />}
  {/* 글 끝: 글쓴이 → 분야·코너 → 함께 읽을 글 → 이전·다음 → 댓글 */}
  <AuthorBox />
  <div class="wrap-narrow post-after">
    <p class="tags">
      <Chip name={post.category} slug={post.categorySlug} color={post.color} />
      {pos && <a class="s-label" href={url(`series/${encodeURIComponent(pos.name)}`)}>{seriesLabel(pos)}</a>}
    </p>
    {related.length > 0 && (
      <section class="s-sec">
        <SecHead title="함께 읽을 글" more={{ href: url(`category/${post.categorySlug}`), text: `${post.category} 모두 보기 →` }} />
        <ul class="rows">{related.map((p) => <PostRow post={p} />)}</ul>
      </section>
    )}
    {(prev || next) && (
      <nav class="pn" aria-label="이전·다음 글">
        {prev ? <a href={url(`posts/${prev.slug}`)}><span class="s-label s-muted">← 이전 글</span><span class="s-serif"><Title title={prev.title} /></span></a> : <span />}
        {next ? <a class="r" href={url(`posts/${next.slug}`)}><span class="s-label s-muted">다음 글 →</span><span class="s-serif"><Title title={next.title} /></span></a> : <span />}
      </nav>
    )}
  </div>
  <Comments slug={post.slug} />
</Base>
